{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-debug-server",
      "type": "shell",
      "command": "./start_server_debug.sh",
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "start-localstack",
      "type": "shell",
      "command": "docker compose --env-file=.env.local -f ./docker/compose-agent.yaml up -d localstack --force-recreate",
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "start-redis",
      "type": "shell",
      "command": "docker compose --env-file=.env.local -f ./docker/compose-agent.yaml up -d redis --force-recreate",
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "start-local-deps",
      "dependsOn": [
        "start-localstack",
        "start-redis"
      ],
      "problemMatcher": []
    }
  ]
}
