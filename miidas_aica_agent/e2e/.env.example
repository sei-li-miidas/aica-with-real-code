OPENAI_API_KEY=

AWS_PROFILE=default
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION_NAME=ap-northeast-1

AICA_WS_ENDPOINT=ws://agent-server:8000/aica/agent/chat
