  "artifact_language": "Japanese",
  "spec_dir": "spec",
  "tmp_dir": "tmp",
  "branches": {
    "issue_base": "feature/{issue_no}/base",
    "plan_wip": "wip/{issue_no}/plan",
    "tasks_wip": "wip/{issue_no}/tasks",
    "task_wip": "wip/{issue_no}/task-{task_no}",
    "e2e_wip": "wip/{issue_no}/e2e"
  },
  "gates": {
    "plan": {
      "approve": false
    },
    "tasks": {
      "approve": false
    },
    "implement": {
      "task_approve": false
    },
    "e2e": {
      "draft_approve": false,
      "review_confirm": false
    },
    "pr_feedback": {
      "approach_approve": false,
      "fix_approve": false
    },
    "pr_body": {
      "approve": false
    },
    "design": {
      "attachment_confirm": false
    },
    "release": {
      "date_confirm": false,
      "base_branch_delete": false
    }
