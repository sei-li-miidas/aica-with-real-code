      ]
    },
    "toolset": {
      "auth_check": "cli:{plugin_root}/tools/redmine-helper",
      "get_issue": "cli:{plugin_root}/tools/redmine-helper",
      "create_subissue": "cli:{plugin_root}/tools/redmine-helper",
      "post_comment": "cli:{plugin_root}/tools/redmine-helper",
      "get_comments": "cli:{plugin_root}/tools/redmine-helper",
      "set_relation": "cli:{plugin_root}/tools/redmine-helper",
      "update_status": "cli:{plugin_root}/tools/redmine-helper",
      "whoami": "cli:{plugin_root}/tools/redmine-helper",
      "get_status": "cli:{plugin_root}/tools/redmine-helper",
      "get_attachment": "cli:{plugin_root}/tools/redmine-helper",
      "get_custom_field": "cli:{plugin_root}/tools/redmine-helper",
      "set_custom_field": "cli:{plugin_root}/tools/redmine-helper",
      "get_release_date": "cli:{plugin_root}/tools/redmine-helper",
      "append_pr_url": "cli:{plugin_root}/tools/redmine-helper",
      "get_pr_url": "cli:{plugin_root}/tools/redmine-helper",
      "get_ai_enabled": "cli:{plugin_root}/tools/redmine-helper",
      "set_ai_enabled": "cli:{plugin_root}/tools/redmine-helper"
