{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "[MCP]Remote Debug",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 6000,
      "host": "127.0.0.1",
      "preLaunchTask": "start-debug-server",
      "substitutePath": [
        {
          "to": "/go/src/aica",
          "from": "${workspaceFolder}/src"
        }
      ]
    },
    {
      "name": "[MCP]Local Debug",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/src/main.go",
      "args": ["--debug", "true"],
      "envFile": "${workspaceFolder}/.env.local"
    },
    {
      "name": "Debug Go Test: Current File",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "cwd": "${workspaceFolder}",
      "args": [],
      "envFile": "${workspaceFolder}/.env.local"
    },
    {
      "name": "Run Go Test: All Packages",
      "type": "node-terminal",
      "request": "launch",
      "command": "cd ${workspaceFolder}/src && mkdir -p .coverage && go test ./... -covermode=atomic -coverprofile=.coverage/all_packages.out && go tool cover -func=.coverage/all_packages.out | tail -n 1"
    }
  ]
}
